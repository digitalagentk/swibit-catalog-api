# Copy to `.env` — docker compose reads it for variable interpolation.

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL (used by the `db` service and to build the API's URL) ---
POSTGRES_USER=swibit
POSTGRES_PASSWORD=swibit
POSTGRES_DB=swibit_catalog
# Host port only. 5433 avoids clashing with a native Postgres on 5432.
POSTGRES_PORT=5433

# Used only when running the API outside Docker (the `db` service publishes
# 5433 to the host). Inside compose the API gets host `db` automatically.
DATABASE_URL=postgresql+psycopg://swibit:swibit@localhost:5433/swibit_catalog

# --- Authentication ---
# HS256 signing key. MUST be replaced with a long random value in production.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-in-production
JWT_EXPIRE_MINUTES=60

# --- Background exports ---
# Directory the generated CSV files are written to (a named volume in compose).
EXPORT_DIR=./exports

# --- Test suite (optional) ---
# Tests use their own database so they never touch development data.
# TEST_DATABASE_URL=postgresql+psycopg://swibit:swibit@localhost:5433/swibit_catalog_test

